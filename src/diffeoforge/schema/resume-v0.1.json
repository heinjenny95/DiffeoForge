{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffeoforge.org/schema/resume-v0.1.json",
  "title": "DiffeoForge resume provenance 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resume_version",
    "created_at",
    "source_run",
    "source_manifest",
    "source_result",
    "source_output_inventory",
    "checkpoint",
    "semantics"
  ],
  "properties": {
    "resume_version": {
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "path",
        "terminal_status"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "terminal_status": {
          "enum": [
            "failed",
            "interrupted",
            "completed"
          ]
        }
      }
    },
    "source_manifest": {
      "$ref": "#/$defs/evidence"
    },
    "source_result": {
      "$ref": "#/$defs/evidence"
    },
    "source_output_inventory": {
      "$ref": "#/$defs/evidence"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "staged_path",
        "execution_path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "staged_path": {
          "const": "resume/source-checkpoint.p"
        },
        "execution_path": {
          "const": "output/deformetrica-state.p"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "iteration_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_maximum_iterations",
        "additional_iterations",
        "maximum_iterations",
        "source_log_sha256"
      ],
      "properties": {
        "source_maximum_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "additional_iterations": {
          "const": 300
        },
        "maximum_iterations": {
          "type": "integer",
          "minimum": 301
        },
        "source_log_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "output_schedule_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_mode",
        "successor_mode"
      ],
      "properties": {
        "source_mode": {
          "enum": [
            "native_full_outputs",
            "compact_final_export",
            "compact_convergence_export"
          ]
        },
        "successor_mode": {
          "enum": [
            "compact_final_export",
            "compact_convergence_export"
          ]
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "backend_version",
        "restored",
        "reinitialized",
        "trajectory_continuity"
      ],
      "properties": {
        "backend_id": {
          "const": "deformetrica_reference"
        },
        "backend_version": {
          "const": "4.3.0"
        },
        "restored": {
          "enum": [
            [
              "current_parameters",
              "current_iteration"
            ],
            [
              "current_parameters",
              "current_iteration",
              "objective_baseline"
            ]
          ]
        },
        "reinitialized": {
          "enum": [
            [
              "objective_baseline",
              "gradient",
              "line_search_step_sizes"
            ],
            [
              "gradient",
              "line_search_step_sizes"
            ]
          ]
        },
        "trajectory_continuity": {
          "const": "not_guaranteed"
        }
      }
    },
    "precision_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_precision", "successor_precision", "checkpoint_storage",
        "model_arithmetic", "reference_evaluation"
      ],
      "properties": {
        "source_precision": {"const": "float32"},
        "successor_precision": {"const": "float64"},
        "checkpoint_storage": {"const": "byte_identical_source"},
        "model_arithmetic": {"const": "native_float64"},
        "reference_evaluation": {"const": "recomputed_in_successor_precision"}
      }
    },
    "convergence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "initial_log_likelihood",
        "origin_iteration",
        "origin_checkpoint_sha256",
        "convergence_tolerance"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "initial_log_likelihood": {
          "type": "number"
        },
        "origin_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "origin_checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "convergence_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["precision_transition"]},
      "then": {"required": ["convergence_reference"]}
    },
    {
      "if": {
        "properties": {
          "source_run": {
            "properties": {
              "terminal_status": {
                "const": "completed"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "iteration_extension"
        ]
      }
    },
    {
      "if": {
        "required": [
          "iteration_extension"
        ]
      },
      "then": {
        "properties": {
          "source_run": {
            "properties": {
              "terminal_status": {
                "const": "completed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "convergence_reference"
        ]
      },
      "then": {
        "properties": {
          "semantics": {
            "properties": {
              "restored": {
                "const": [
                  "current_parameters",
                  "current_iteration",
                  "objective_baseline"
                ]
              },
              "reinitialized": {
                "const": [
                  "gradient",
                  "line_search_step_sizes"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "semantics": {
            "properties": {
              "restored": {
                "const": [
                  "current_parameters",
                  "current_iteration"
                ]
              },
              "reinitialized": {
                "const": [
                  "objective_baseline",
                  "gradient",
                  "line_search_step_sizes"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
