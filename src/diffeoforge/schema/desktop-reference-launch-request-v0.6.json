{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffeoForge desktop reference launch request",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "reference_launch_request_version",
    "request_id",
    "engine",
    "config_path",
    "expected_config_sha256",
    "run_id",
    "destination",
    "resume_source",
    "launcher",
    "additional_iterations",
    "final_export_only",
    "quality_continuation"
  ],
  "properties": {
    "final_export_only": {
      "const": false
    },
    "reference_launch_request_version": {
      "const": "0.6"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "engine": {
      "const": "deformetrica_reference"
    },
    "config_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "resume_source": {
      "type": "string",
      "minLength": 1
    },
    "launcher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "engine",
            "image"
          ],
          "properties": {
            "type": {
              "const": "container"
            },
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "distribution",
            "executable"
          ],
          "properties": {
            "type": {
              "const": "wsl"
            },
            "distribution": {
              "type": "string",
              "minLength": 1
            },
            "executable": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "executable"
          ],
          "properties": {
            "type": {
              "const": "native"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "additional_iterations": {
      "type": "integer",
      "const": 0
    },
    "quality_continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "checkpoint_iteration", "additional_iterations", "source_reason",
                   "source_mode", "source_maximum_iterations", "source_tolerance",
                   "checkpoint_sha256", "source_log_sha256"],
      "properties": {
        "mode": {"enum": ["morphospace_stability", "morphospace_stability_unlimited"]},
        "checkpoint_iteration": {"type": "integer", "minimum": 1},
        "additional_iterations": {"type": ["integer", "null"], "minimum": 1},
        "source_mode": {"enum": ["optimizer_convergence", "morphospace_stability", "iteration_target"]},
        "source_maximum_iterations": {"type": ["integer", "null"], "minimum": 1},
        "source_reason": {"enum": ["native_tolerance", "iteration_limit", "morphospace_stable",
                                   "line_search_exhausted", "optimizer_callback"]},
        "source_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_log_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
