{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffeoForge desktop reference worker event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_worker_event_version",
    "request_id",
    "sequence",
    "kind",
    "payload"
  ],
  "properties": {
    "reference_worker_event_version": {"const": "0.1"},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["accepted", "phase", "activity", "progress", "terminal"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "accepted"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/accepted"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "phase"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/phase"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "activity"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/activity"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "progress"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/progress"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "terminal"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/terminal"}}}
    }
  ],
  "$defs": {
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "config_sha256",
        "destination",
        "cancellation"
      ],
      "properties": {
        "engine": {"const": "deformetrica_reference"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "destination": {"type": "string", "minLength": 1},
        "cancellation": {"const": "phase_dependent"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "message"],
      "properties": {
        "phase": {
          "enum": [
            "verify_request",
            "preflight",
            "prepare",
            "execute",
            "finalize",
            "verify_result"
          ]
        },
        "message": {"type": "string", "minLength": 1}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "maximum_iterations",
        "log_likelihood",
        "attachment",
        "regularity",
        "elapsed_seconds",
        "seconds_per_iteration",
        "eta_to_iteration_cap_seconds",
        "estimate_status"
      ],
      "properties": {
        "iteration": {"type": "integer", "minimum": 0},
        "maximum_iterations": {"type": "integer", "minimum": 1},
        "log_likelihood": {"type": "number"},
        "attachment": {"type": "number"},
        "regularity": {"type": "number"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "seconds_per_iteration": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "eta_to_iteration_cap_seconds": {"type": ["number", "null"], "minimum": 0},
        "likely_convergence_iteration_lower": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "likely_convergence_iteration_upper": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "eta_to_likely_convergence_lower_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "eta_to_likely_convergence_upper_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "resource_contention_detected": {"type": "boolean"},
        "estimate_status": {
          "enum": [
            "warming_up",
            "observed_rate_to_iteration_cap",
            "observed_rate_to_cap_with_resource_contention"
          ]
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "elapsed_seconds",
        "maximum_iterations",
        "latest_message",
        "log_source",
        "last_iteration"
      ],
      "properties": {
        "state": {
          "enum": ["computing_first_iteration", "optimizing"]
        },
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "maximum_iterations": {"type": "integer", "minimum": 1},
        "latest_message": {"type": "string", "minLength": 1},
        "log_source": {"type": ["string", "null"]},
        "last_iteration": {"type": ["integer", "null"], "minimum": 0},
        "resources": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/resources"}
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_process_id",
        "requested_device",
        "process_tree",
        "gpu",
        "boundary"
      ],
      "properties": {
        "backend_process_id": {"type": "integer", "minimum": 1},
        "requested_device": {"enum": ["cpu", "cuda"]},
        "process_tree": {"$ref": "#/$defs/process_tree_resources"},
        "gpu": {"$ref": "#/$defs/gpu_resources"},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "process_tree_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "process_count",
        "cpu_percent",
        "rss_bytes",
        "system_memory_percent",
        "system_memory_available_bytes",
        "system_memory_total_bytes"
      ],
      "properties": {
        "status": {"enum": ["observed", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "process_count": {"type": ["integer", "null"], "minimum": 1},
        "cpu_percent": {"type": ["number", "null"], "minimum": 0},
        "rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "system_memory_percent": {"type": ["number", "null"], "minimum": 0},
        "system_memory_available_bytes": {"type": ["integer", "null"], "minimum": 0},
        "system_memory_total_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "gpu_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "utilization_percent",
        "memory_used_bytes",
        "memory_total_bytes",
        "reason"
      ],
      "properties": {
        "status": {"enum": ["observed", "unavailable", "not_requested"]},
        "scope": {"enum": ["none", "device_total_not_attributed_to_run"]},
        "utilization_percent": {"type": ["number", "null"], "minimum": 0},
        "memory_used_bytes": {"type": ["integer", "null"], "minimum": 0},
        "memory_total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "destination",
        "destination_exists",
        "result_sha256",
        "message"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "completed",
            "stopped_before_prepare",
            "prepared_not_executed",
            "interrupted",
            "failed"
          ]
        },
        "destination": {"type": "string", "minLength": 1},
        "destination_exists": {"type": "boolean"},
        "result_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "message": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {"const": "completed"},
            "destination_exists": {"const": true},
            "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "properties": {
            "outcome": {"const": "stopped_before_prepare"},
            "destination_exists": {"const": false},
            "result_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "outcome": {"const": "prepared_not_executed"},
            "destination_exists": {"const": true},
            "result_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "outcome": {"const": "interrupted"},
            "destination_exists": {"const": true},
            "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "properties": {
            "outcome": {"const": "failed"}
          }
        }
      ]
    }
  }
}
