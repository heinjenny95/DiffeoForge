{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffeoForge optimizer benchmark study progress event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "progress_version",
    "sequence",
    "status",
    "message",
    "completed_conditions",
    "total_conditions",
    "condition",
    "observation"
  ],
  "properties": {
    "progress_version": {"const": "0.2"},
    "sequence": {"type": "integer", "minimum": 0},
    "status": {
      "enum": [
        "study_started",
        "study_resumed",
        "condition_started",
        "condition_progress",
        "condition_completed",
        "condition_reconciled",
        "study_interrupted",
        "study_completed",
        "study_already_complete"
      ]
    },
    "message": {"type": "string", "minLength": 1},
    "completed_conditions": {"type": "integer", "minimum": 0},
    "total_conditions": {"type": "integer", "minimum": 1},
    "condition": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "condition_id", "subject_count", "cycle_cap"],
          "properties": {
            "sequence": {"type": "integer", "minimum": 1, "maximum": 1000},
            "condition_id": {
              "type": "string",
              "pattern": "^condition-[0-9]{4}-subjects-[0-9]{4}-cycles-[0-9]{3}$"
            },
            "subject_count": {"type": "integer", "minimum": 1, "maximum": 1000},
            "cycle_cap": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      ]
    },
    "observation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repeat", "total_repeats", "optimizer_elapsed_ns", "optimizer"],
          "properties": {
            "repeat": {"type": "integer", "minimum": 1, "maximum": 50},
            "total_repeats": {"type": "integer", "minimum": 1, "maximum": 50},
            "optimizer_elapsed_ns": {"type": "integer", "minimum": 0},
            "optimizer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "completed_decisions",
                "maximum_decisions",
                "cycle",
                "max_cycles",
                "block",
                "status",
                "objective",
                "attachment",
                "regularity",
                "gradient_norm",
                "accepted_step_size",
                "line_search_evaluations"
              ],
              "properties": {
                "completed_decisions": {"type": "integer", "minimum": 0},
                "maximum_decisions": {"type": "integer", "minimum": 0},
                "cycle": {"type": "integer", "minimum": 0},
                "max_cycles": {"type": "integer", "minimum": 0},
                "block": {
                  "oneOf": [
                    {"type": "null"},
                    {"enum": ["momenta", "template", "control_points"]}
                  ]
                },
                "status": {"enum": ["initial", "accepted", "stationary", "failed"]},
                "objective": {"type": "number"},
                "attachment": {"type": "number"},
                "regularity": {"type": "number"},
                "gradient_norm": {"type": ["number", "null"]},
                "accepted_step_size": {"type": ["number", "null"]},
                "line_search_evaluations": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      ]
    }
  }
}
